---
import { Icon } from "astro-icon/components";
import "../styles/global.css";

// Properties
const title = Astro.props.title;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="text-white bg-linear-to-br from-gray-900 to-gray-800 h-dvh">
		<header class="flex justify-between p-2 bg-gray-800 border-b-1 border-b-gray-500">
			<h1 class="font-semibold text-xl">
				Raven<span class="font-light">Node</span>
			</h1>
			<ul class="flex space-x-2">
				<li>
					<a
						href="#"
						target="_blank"
						rel="noreferrer"
						title="Invite link to the RavenNode Discord server."
						><Icon name="mdi:discord" size={24} /></a
					>
				</li>
				<li>
					<a
						href="https://github.com/DeepWolf413"
						target="_blank"
						rel="noreferrer"
						title="Profile of DeepWolf413 on GitHub."
						><Icon name="mdi:github" size={24} /></a
					>
				</li>
			</ul>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
