---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
interface Props {
    title: string;
    description?: string;
    backgroundImage: string;
}

const { title, description, backgroundImage } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/cards/*.{jpeg,jpg,png}",
);

if (!images[backgroundImage])
    throw new Error(
        `"${backgroundImage}" does not exist in glob: "src/assets/cards/*.{jpeg,jpg,png,gif}"`,
    );

const importedImage = await images[backgroundImage]();
const img = await getImage({ src: importedImage.default });
---

<section
    class="relative opacity-75 transition rounded-xl bg-cover outline-2 outline-gray-900 to-black from-black/20 shadow-2xl bg-[linear-gradient(to_bottom,var(--tw-gradient-from),var(--tw-gradient-to)),var(--image)] h-72 min-w-56
    hover:scale-105 hover:opacity-100 hover:from-white/20 hover:outline-white"
>
    <h3
        class="absolute bottom-4 left-0 right-0 text-center pointer-events-none text-gray-300 text-xl"
    >
        {title}
    </h3>
    <a class="block w-full h-full" href="#"></a>
</section>
<style define:vars={{ image: `url("${img.src}")` }}></style>
